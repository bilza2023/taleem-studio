{
    "version": "deck-v2",
    "name": "Rational Numbers",
    "background": {
        "backgroundColor": "#05070c",
        "backgroundImage": "/content/images/space.webp",
        "backgroundImageOpacity": 0.4
    },
    "audio": "fbise8math-ch1-rational-numbers.opus",
    "deck": [
        {
            "type": "titleAndSubtitle",
            "start": 0,
            "end": 4.9,
            "data": [
                {
                    "name": "title",
                    "content": "Rational Numbers",
                    "showAt": 0
                },
                {
                    "name": "subtitle",
                    "content": "Every number that can be written as a/b — and what its decimal looks like",
                    "showAt": 2.8
                }
            ]
        },
        {
            "type": "eq",
            "start": 4.9,
            "end": 17.3,
            "data": [
                {
                    "name": "line",
                    "type": "heading",
                    "content": "What is a Rational Number?",
                    "showAt": 4.9,
                    "spItems": []
                },
                {
                    "name": "line",
                    "type": "text",
                    "content": "When an integer a is divided by an integer b (b ≠ 0), the result is a rational number",
                    "showAt": 9.7,
                    "spItems": []
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "\\frac{a}{b}, \\quad a, b \\in \\mathbb{Z}, \\; b \\neq 0",
                    "showAt": 15.5,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "a = numerator, b = denominator"
                        },
                        {
                            "type": "text",
                            "content": "b can never be 0 — division by zero is undefined"
                        }
                    ]
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "Q = \\left\\{ x : x = \\frac{a}{b}, \\; a, b \\in \\mathbb{Z}, \\; b \\neq 0 \\right\\}",
                    "showAt": 16,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "The set of rational numbers is denoted by Q"
                        },
                        {
                            "type": "math",
                            "content": "\\mathbb{Z} = \\{\\ldots, -2, -1, 0, 1, 2, \\ldots\\}"
                        }
                    ]
                },
                {
                    "name": "line",
                    "type": "text",
                    "content": "Fact: the word “rational” comes from “ratio” — a rational number is a ratio of two integers",
                    "showAt": 16.4,
                    "spItems": []
                }
            ]
        },
        {
            "type": "eq",
            "start": 17.3,
            "end": 22.1,
            "data": [
                {
                    "name": "line",
                    "type": "heading",
                    "content": "Examples of Rational Numbers",
                    "showAt": 17.3,
                    "spItems": []
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "5 = \\frac{5}{1}, \\quad -3 = \\frac{-3}{1}, \\quad 0 = \\frac{0}{1}",
                    "showAt": 18.6,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "Every integer is rational — just put it over 1"
                        }
                    ]
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "\\frac{3}{4}, \\quad -\\frac{2}{5}, \\quad \\frac{7}{2}",
                    "showAt": 19.8,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "All fractions are rational"
                        }
                    ]
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "2\\frac{1}{2} = \\frac{5}{2}",
                    "showAt": 20.5,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "Mixed numbers are rational too"
                        }
                    ]
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "0.25 = \\frac{25}{100} = \\frac{1}{4}",
                    "showAt": 21.1,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "A terminating decimal can be written as a/b → rational"
                        }
                    ]
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "\\frac{7}{0}",
                    "showAt": 21.6,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "NOT a rational number — the denominator is 0, so it is undefined"
                        }
                    ]
                }
            ]
        },
        {
            "type": "imageSlide",
            "start": 22.1,
            "end": 22.6,
            "data": [
                {
                    "name": "image",
                    "content": "fbise8math-ch1-decimal-types.svg",
                    "showAt": 22.1
                }
            ]
        },
        {
            "type": "imageLeftBulletsRight",
            "start": 22.6,
            "end": 24,
            "data": [
                {
                    "name": "image",
                    "content": "fbise8math-ch1-decimal-types.svg",
                    "showAt": 22.6
                },
                {
                    "name": "bullet",
                    "content": "To write a/b as a decimal, divide a by b",
                    "showAt": 23
                },
                {
                    "name": "bullet",
                    "content": "If the division ends, the decimal is terminating",
                    "showAt": 23.5
                },
                {
                    "name": "bullet",
                    "content": "If a digit or block of digits repeats forever, it is recurring",
                    "showAt": 23.6
                },
                {
                    "name": "bullet",
                    "content": "Terminating and recurring decimals are both rational",
                    "showAt": 23.8
                }
            ]
        },
        {
            "type": "eq",
            "start": 24,
            "end": 25.8,
            "data": [
                {
                    "name": "line",
                    "type": "heading",
                    "content": "Terminating Decimal Fractions",
                    "showAt": 24,
                    "spItems": []
                },
                {
                    "name": "line",
                    "type": "text",
                    "content": "A finite number of digits in the decimal part — the division stops",
                    "showAt": 24.2,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "Remainder becomes 0"
                        }
                    ]
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "\\frac{1}{4} = 0.25",
                    "showAt": 25,
                    "spItems": []
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "\\frac{2}{5} = 0.4",
                    "showAt": 25.2,
                    "spItems": []
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "\\frac{3}{2} = 1.5",
                    "showAt": 25.4,
                    "spItems": []
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "\\frac{7}{4} = 1.75",
                    "showAt": 25.6,
                    "spItems": []
                }
            ]
        },
        {
            "type": "eq",
            "start": 25.8,
            "end": 27.6,
            "data": [
                {
                    "name": "line",
                    "type": "heading",
                    "content": "Recurring Decimal Fractions",
                    "showAt": 25.8,
                    "spItems": []
                },
                {
                    "name": "line",
                    "type": "text",
                    "content": "A single digit or a group of digits repeats again and again in the same order",
                    "showAt": 26.2,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "The division never ends — the remainders start repeating"
                        }
                    ]
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "\\frac{1}{3} = 0.333333\\ldots = 0.\\dot{3} = 0.\\overline{3}",
                    "showAt": 26.5,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "Dot or bar over the repeating digit — both are correct"
                        }
                    ]
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "\\frac{7}{22} = 0.3181818\\ldots = 0.3\\overline{18}",
                    "showAt": 26.8,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "The 3 does not repeat — only the block 18 does"
                        }
                    ]
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "\\frac{1}{13} = 0.076923076923\\ldots = 0.\\overline{076923}",
                    "showAt": 27.2,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "Block of 6 digits repeats"
                        }
                    ]
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "\\frac{1}{7} = 0.142857142857\\ldots = 0.\\overline{142857}",
                    "showAt": 27.3,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "Fact: every terminating and every recurring decimal can be written as a fraction → rational"
                        }
                    ]
                }
            ]
        },
        {
            "type": "eq",
            "start": 27.6,
            "end": 29.6,
            "data": [
                {
                    "name": "line",
                    "type": "heading",
                    "content": "Example: Write the Decimal Representation",
                    "showAt": 27.6,
                    "spItems": []
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "\\frac{1}{3} = 0.333\\ldots = 0.\\overline{3}",
                    "showAt": 28,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "Same digit is repeating"
                        }
                    ]
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "3\\frac{2}{11} = 3 + \\frac{2}{11} = 3.181818\\ldots = 3.\\overline{18}",
                    "showAt": 28.2,
                    "spItems": [
                        {
                            "type": "math",
                            "content": "2 \\div 11 = 0.181818\\ldots"
                        },
                        {
                            "type": "text",
                            "content": "A block of 2 digits is repeating"
                        }
                    ]
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "\\frac{4}{7} = 0.571428571428\\ldots = 0.\\overline{571428}",
                    "showAt": 28.4,
                    "spItems": [
                        {
                            "type": "text",
                            "content": "A block of 6 digits is repeating"
                        }
                    ]
                },
                {
                    "name": "line",
                    "type": "math",
                    "content": "3\\frac{7}{12} = 3 + \\frac{7}{12} = 3.58333\\ldots = 3.58\\overline{3}",
                    "showAt": 29.2,
                    "spItems": [
                        {
                            "type": "math",
                            "content": "7 \\div 12 = 0.58333\\ldots"
                        },
                        {
                            "type": "text",
                            "content": "Only the 3 repeats — 5 and 8 do not"
                        }
                    ]
                }
            ]
        },
        {
            "type": "keyIdeasSlide",
            "start": 29.6,
            "end": 274.7,
            "data": [
                {
                    "name": "card",
                    "icon": "➗",
                    "label": "Rational = a/b, with a, b integers and b ≠ 0",
                    "showAt": 29.6
                },
                {
                    "name": "card",
                    "icon": "🔢",
                    "label": "Every integer is rational (5 = 5/1)",
                    "showAt": 29.9
                },
                {
                    "name": "card",
                    "icon": "🛑",
                    "label": "Terminating decimals are rational",
                    "showAt": 30.4
                },
                {
                    "name": "card",
                    "icon": "🔁",
                    "label": "Recurring decimals are rational",
                    "showAt": 31.3
                }
            ]
        }
    ]
}