      "deck": [
        { "type": "titleAndSubtitle", "data": [
          { "name": "title", "content": "Exercise 2.2 — Q3(ii)", "showAt": 0 },
          { "name": "subtitle", "content": "Find the Value of x", "showAt": 0 }
        ], "start": 0, "end": 5 },
        { "type": "eq", "data": [
          { "name": "line", "type": "math", "content": "\\log_{x+1} 9 = 2", "showAt": 5, "spItems": [
            { "type": "text", "content": "Convert to exponential form" }
          ]},
          { "name": "line", "type": "math", "content": "(x+1)^2 = 9 \\implies x+1 = 3", "showAt": 9, "spItems": [
            { "type": "text", "content": "Base must be positive, so take the positive root" }
          ]},
          { "name": "line", "type": "math", "content": "x = 2", "showAt": 13, "spItems": [] }
        ], "start": 5, "end": 17 }
      ]
    }
  },
  {
    "slug": "fbise9math-ex2-2-q3-iii",
    "body": {
      "version": "deck-v2",
