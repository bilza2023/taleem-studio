  {
    "slug": "fbise9math-ex2-2-q4-iv",
    "body": {
      "version": "deck-v2",
      "background": { "backgroundColor": "#05070c", "backgroundImage": "space.webp", "backgroundImageOpacity": 0.4 },
      "audio": "music.mp3",
      "deck": [
        { "type": "titleAndSubtitle", "data": [
          { "name": "title", "content": "Exercise 2.2 — Q4 (from Q2-iv)", "showAt": 0 },
          { "name": "subtitle", "content": "Find the Unknown", "showAt": 0 }
        ], "start": 0, "end": 5 },
        { "type": "eq", "data": [
          { "name": "line", "type": "math", "content": "b^{-3/4} = \\frac{1}{27}", "showAt": 5, "spItems": [
            { "type": "text", "content": "From Q2(iv). Write 1/27 as a power of 3" }
          ]},
          { "name": "line", "type": "math", "content": "b^{-3/4} = 3^{-3}", "showAt": 9, "spItems": [] },
          { "name": "line", "type": "math", "content": "b = \\left(3^{-3}\\right)^{-4/3} = 3^4 = 81", "showAt": 13, "spItems": [
