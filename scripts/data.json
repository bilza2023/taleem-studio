            { "type": "text", "content": "Convert to exponential form" }
          ]},
          { "name": "line", "type": "math", "content": "3^x = 81 = 3^4", "showAt": 9, "spItems": [] },
          { "name": "line", "type": "math", "content": "x = 4", "showAt": 13, "spItems": [] }
