          { "name": "line", "type": "heading", "content": "Miscellaneous Exercise 5 — Q1(xiii)", "showAt": 0, "spItems": [] },
          { "name": "line", "type": "math", "content": "\\text{What should be the value of } k \\text{ if } x < y \\text{ shows } kx > ky\\text{?}", "showAt": 5, "spItems": [] },
          { "name": "line", "type": "math", "content": "\\text{(a) } k = 0 \\qquad \\text{(b) } k > 0 \\qquad \\text{(c) } k < 0 \\qquad \\text{(d) } k \\ge 0", "showAt": 10, "spItems": [] },
          { "name": "line", "type": "text", "content": "The symbol changed from < to >. The inequality symbol is reversed only when both sides are multiplied by a negative number.", "showAt": 15, "spItems": [ { "type": "math", "content": "-2 < 5 \\Rightarrow (-3)(-2) > (-3)(5)" } ] },
