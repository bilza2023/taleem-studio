[
  {
    "slug": "fbise9math-ch5-intro-linear-equations",
    "body": {
      "version": "deck-v2",
      "name": "Linear Equations in One Variable",
      "background": { "backgroundColor": "#05070c", "backgroundImage": "space.webp", "backgroundImageOpacity": 0.4 },
      "audio": "music.mp3",
      "deck": [
        { "type": "titleAndSubtitle", "start": 0, "end": 8, "data": [
          { "name": "title", "content": "Linear Equations in One Variable", "showAt": 0 },
          { "name": "subtitle", "content": "Standard form, solutions and equivalent equations", "showAt": 2 }
        ]},
        { "type": "bulletList", "start": 8, "end": 30, "data": [
          { "name": "heading", "content": "What is a linear equation?", "showAt": 8 },
          { "name": "bullet", "content": "Standard form: ax + b = 0, where a, b are real numbers and a ≠ 0", "showAt": 10 },
          { "name": "bullet", "content": "The exponent of the variable is always 1, so x² = 4 is non-linear", "showAt": 14 },
          { "name": "bullet", "content": "No product of variables, so xy = 14 is non-linear", "showAt": 18 },
          { "name": "bullet", "content": "Also called an equation of degree one", "showAt": 22 },
          { "name": "bullet", "content": "Examples: 2x + 3 = 0, 5x + 3 = 5", "showAt": 26 }
        ]},
        { "type": "bulletList", "start": 30, "end": 46, "data": [
          { "name": "heading", "content": "Solutions and equivalent equations", "showAt": 30 },
          { "name": "bullet", "content": "A solution is a value of the variable that makes the equation true", "showAt": 32 },
          { "name": "bullet", "content": "A linear equation in standard form has exactly one solution", "showAt": 36 },
          { "name": "bullet", "content": "Equivalent equations have the same solution, e.g. 2x + 3 = 4 and 2x = 1", "showAt": 40 },
          { "name": "bullet", "content": "Isolate the variable using the properties of equality (+, −, ×, ÷)", "showAt": 43 }
        ]},
        { "type": "eq", "start": 46, "end": 84, "data": [
          { "name": "line", "type": "heading", "content": "Example: Solve −7x + 24 = 3", "showAt": 46, "spItems": [] },
          { "name": "line", "type": "math", "content": "-7x + 24 = 3", "showAt": 50, "spItems": [ { "type": "text", "content": "Original equation" } ] },
          { "name": "line", "type": "math", "content": "-7x + 24 - 24 = 3 - 24", "showAt": 54, "spItems": [ { "type": "text", "content": "Subtract 24 from both sides" } ] },
          { "name": "line", "type": "math", "content": "-7x = -21", "showAt": 58, "spItems": [] },
          { "name": "line", "type": "math", "content": "x = 3", "showAt": 62, "spItems": [ { "type": "text", "content": "Divide both sides by −7" } ] },
          { "name": "line", "type": "heading", "content": "Check", "showAt": 66, "spItems": [] },
          { "name": "line", "type": "math", "content": "-7(3) + 24 \\stackrel{?}{=} 3", "showAt": 70, "spItems": [ { "type": "text", "content": "Replace x by 3 in the original equation" } ] },
          { "name": "line", "type": "math", "content": "-21 + 24 = 3 \\quad \\Rightarrow \\quad 3 = 3", "showAt": 74, "spItems": [ { "type": "text", "content": "The solution is checked" } ] },
          { "name": "line", "type": "text", "content": "Hence x = 3 is the required root.", "showAt": 78, "spItems": [] }
        ]},
        { "type": "eq", "start": 84, "end": 110, "data": [
          { "name": "line", "type": "heading", "content": "Equations with fractions", "showAt": 84, "spItems": [] },
          { "name": "line", "type": "math", "content": "\\frac{3x}{5} - \\frac{1}{2} = \\frac{x}{4} + 1", "showAt": 88, "spItems": [ { "type": "text", "content": "Clear the fractions: multiply every term by the LCM" }, { "type": "text", "content": "LCM of 5, 2 and 4 = 20" } ] },
          { "name": "line", "type": "math", "content": "12x - 10 = 5x + 20", "showAt": 92, "spItems": [ { "type": "text", "content": "Every term multiplied by 20" } ] },
          { "name": "line", "type": "math", "content": "12x - 5x = 20 + 10", "showAt": 96, "spItems": [ { "type": "text", "content": "Move x-terms left, constants right" } ] },
          { "name": "line", "type": "math", "content": "7x = 30 \\quad \\Rightarrow \\quad x = \\frac{30}{7}", "showAt": 100, "spItems": [] },
          { "name": "line", "type": "text", "content": "Hence x = 30/7 is the required root.", "showAt": 104, "spItems": [] }
        ]}
      ]
    }
  },
  {
    "slug": "fbise9math-ch5-intro-radical-equations",
    "body": {
      "version": "deck-v2",
      "name": "Radical Equations",
      "background": { "backgroundColor": "#05070c", "backgroundImage": "space.webp", "backgroundImageOpacity": 0.4 },
      "audio": "music.mp3",
      "deck": [
        { "type": "titleAndSubtitle", "start": 0, "end": 8, "data": [
          { "name": "title", "content": "Radical Equations", "showAt": 0 },
          { "name": "subtitle", "content": "Isolate, square, solve, then always check", "showAt": 2 }
        ]},
        { "type": "bulletList", "start": 8, "end": 28, "data": [
          { "name": "heading", "content": "What is a radical equation?", "showAt": 8 },
          { "name": "bullet", "content": "The variable appears under a radical (square root) sign", "showAt": 10 },
          { "name": "bullet", "content": "Examples: √(x + 1) = 7, √x = 9, √(2x − 3) = √(x + 5)", "showAt": 14 },
          { "name": "bullet", "content": "If x = y then x² = y², so squaring both sides is allowed", "showAt": 18 },
          { "name": "bullet", "content": "But equal squares do not mean equal numbers: (−5)² = 5², yet −5 ≠ 5", "showAt": 22 }
        ]},
        { "type": "bulletList", "start": 28, "end": 46, "data": [
          { "name": "heading", "content": "Steps to solve", "showAt": 28 },
          { "name": "bullet", "content": "I. Get the radical term alone on one side", "showAt": 30 },
          { "name": "bullet", "content": "II. Square both sides of the equation", "showAt": 33 },
          { "name": "bullet", "content": "III. Solve the resulting linear equation", "showAt": 36 },
          { "name": "bullet", "content": "IV. Check the solution in the original equation", "showAt": 39 }
        ]},
        { "type": "eq", "start": 46, "end": 72, "data": [
          { "name": "line", "type": "heading", "content": "Example: Solve √x + 3 = 7", "showAt": 46, "spItems": [] },
          { "name": "line", "type": "math", "content": "\\sqrt{x} + 3 = 7", "showAt": 50, "spItems": [ { "type": "text", "content": "Step I: isolate the radical" } ] },
          { "name": "line", "type": "math", "content": "\\sqrt{x} = 4", "showAt": 54, "spItems": [ { "type": "text", "content": "Subtract 3 from both sides" } ] },
          { "name": "line", "type": "math", "content": "\\left(\\sqrt{x}\\right)^2 = (4)^2 \\quad \\Rightarrow \\quad x = 16", "showAt": 58, "spItems": [ { "type": "text", "content": "Steps II and III: square and solve" } ] },
          { "name": "line", "type": "math", "content": "\\text{Check: } \\sqrt{16} + 3 = 4 + 3 = 7", "showAt": 62, "spItems": [ { "type": "text", "content": "Step IV: the solution is checked" } ] },
          { "name": "line", "type": "math", "content": "\\text{Solution set} = \\{16\\}", "showAt": 66, "spItems": [] }
        ]},
        { "type": "eq", "start": 72, "end": 106, "data": [
          { "name": "line", "type": "heading", "content": "Extraneous roots", "showAt": 72, "spItems": [] },
          { "name": "line", "type": "text", "content": "Squaring can create an extra root that does not satisfy the original equation. This is called an extraneous root.", "showAt": 76, "spItems": [ { "type": "text", "content": "This is why step IV (check) is necessary" } ] },
          { "name": "line", "type": "math", "content": "4 + 2\\sqrt{3y + 1} = 3", "showAt": 80, "spItems": [] },
          { "name": "line", "type": "math", "content": "2\\sqrt{3y + 1} = -1", "showAt": 84, "spItems": [ { "type": "text", "content": "Isolate: the radical equals a negative number" } ] },
          { "name": "line", "type": "text", "content": "A square root can never be negative, so there is no solution.", "showAt": 88, "spItems": [ { "type": "text", "content": "Key fact: an isolated radical equal to a negative number means no solution" } ] },
          { "name": "line", "type": "math", "content": "\\text{Squaring anyway: } 4(3y + 1) = 1 \\Rightarrow y = -\\frac{1}{4}", "showAt": 92, "spItems": [] },
          { "name": "line", "type": "math", "content": "\\text{Check: } 4 + 2\\sqrt{\\frac{1}{4}} = 4 + 1 = 5 \\neq 3", "showAt": 96, "spItems": [ { "type": "text", "content": "y = −1/4 is an extraneous root" } ] },
          { "name": "line", "type": "math", "content": "\\text{Solution set} = \\phi", "showAt": 100, "spItems": [] }
        ]}
      ]
    }
  },
  {
    "slug": "fbise9math-ch5-intro-absolute-value",
    "body": {
      "version": "deck-v2",
      "name": "Absolute Value Equations",
      "background": { "backgroundColor": "#05070c", "backgroundImage": "space.webp", "backgroundImageOpacity": 0.4 },
      "audio": "music.mp3",
      "deck": [
        { "type": "titleAndSubtitle", "start": 0, "end": 8, "data": [
          { "name": "title", "content": "Absolute Value Equations", "showAt": 0 },
          { "name": "subtitle", "content": "Distance from zero, and why the equation splits in two", "showAt": 2 }
        ]},
        { "type": "imageSlide", "start": 8, "end": 14, "data": [
          { "name": "image", "content": "ch5-abs-value-distance.svg", "showAt": 8 }
        ]},
        { "type": "imageLeftBulletsRight", "start": 14, "end": 34, "data": [
          { "name": "image", "content": "ch5-abs-value-distance.svg", "showAt": 14 },
          { "name": "bullet", "content": "The absolute value of a number is its distance from 0 on the number line", "showAt": 16 },
          { "name": "bullet", "content": "−5 and 5 are both 5 units from 0, so |−5| = |5| = 5", "showAt": 20 },
          { "name": "bullet", "content": "Distance is never negative, so |x| is always positive or zero", "showAt": 24 },
          { "name": "bullet", "content": "|x| = x if x ≥ 0, and |x| = −x if x < 0", "showAt": 28 }
        ]},
        { "type": "bulletList", "start": 34, "end": 52, "data": [
          { "name": "heading", "content": "Solving |x| = k", "showAt": 34 },
          { "name": "bullet", "content": "k > 0: two solutions, x = k or x = −k", "showAt": 36 },
          { "name": "bullet", "content": "k = 0: one solution, x = 0", "showAt": 40 },
          { "name": "bullet", "content": "k < 0: no solution, the solution set is φ", "showAt": 44 },
          { "name": "bullet", "content": "For |ax + b| = c with c > 0, solve ax + b = c and ax + b = −c separately", "showAt": 48 }
        ]},
        { "type": "eq", "start": 52, "end": 78, "data": [
          { "name": "line", "type": "heading", "content": "Example: Solve |2x + 5| = 11", "showAt": 52, "spItems": [] },
          { "name": "line", "type": "math", "content": "|2x + 5| = 11", "showAt": 56, "spItems": [] },
          { "name": "line", "type": "math", "content": "2x + 5 = 11 \\quad \\text{or} \\quad 2x + 5 = -11", "showAt": 60, "spItems": [ { "type": "text", "content": "Remove the bars and write two equations" } ] },
          { "name": "line", "type": "math", "content": "2x = 6 \\quad \\text{or} \\quad 2x = -16", "showAt": 64, "spItems": [ { "type": "text", "content": "Subtract 5 in each equation" } ] },
          { "name": "line", "type": "math", "content": "x = 3 \\quad \\text{or} \\quad x = -8", "showAt": 68, "spItems": [ { "type": "text", "content": "Divide by 2 in each equation" } ] },
          { "name": "line", "type": "math", "content": "\\text{Solution set} = \\{-8, 3\\}", "showAt": 72, "spItems": [] }
        ]}
      ]
    }
  },
  {
    "slug": "fbise9math-ch5-intro-inequalities",
    "body": {
      "version": "deck-v2",
      "name": "Linear Inequalities",
      "background": { "backgroundColor": "#05070c", "backgroundImage": "space.webp", "backgroundImageOpacity": 0.4 },
      "audio": "music.mp3",
      "deck": [
        { "type": "titleAndSubtitle", "start": 0, "end": 8, "data": [
          { "name": "title", "content": "Linear Inequalities", "showAt": 0 },
          { "name": "subtitle", "content": "Symbols, solution sets and compound inequalities", "showAt": 2 }
        ]},
        { "type": "table", "start": 8, "end": 20, "data": [
          ["Symbol", "Meaning", "Example"],
          ["<", "is less than", "−5 < 7"],
          [">", "is greater than", "10 > −3"],
          ["≤", "is less than or equal to", "7 ≤ 7"],
          ["≥", "is greater than or equal to", "5 ≥ 1"],
          ["≠", "is not equal to", "3 ≠ 5"]
        ]},
        { "type": "bulletList", "start": 20, "end": 40, "data": [
          { "name": "heading", "content": "Linear inequality in one variable", "showAt": 20 },
          { "name": "bullet", "content": "Standard form: ax + b < 0 or ax + b > 0 (also ≤, ≥), where a ≠ 0", "showAt": 22 },
          { "name": "bullet", "content": "A strict inequality uses only < or >", "showAt": 26 },
          { "name": "bullet", "content": "The solution set is the set of all real numbers that satisfy the inequality", "showAt": 30 },
          { "name": "bullet", "content": "Multiplying or dividing both sides by a negative number reverses the symbol", "showAt": 34 }
        ]},
        { "type": "eq", "start": 40, "end": 66, "data": [
          { "name": "line", "type": "heading", "content": "Reversing the symbol", "showAt": 40, "spItems": [] },
          { "name": "line", "type": "math", "content": "-2 < 5 \\quad \\Rightarrow \\quad (-3)(-2) > (-3)(5) \\quad \\Rightarrow \\quad 6 > -15", "showAt": 44, "spItems": [ { "type": "text", "content": "Multiplying by −3 reverses < to >" } ] },
          { "name": "line", "type": "heading", "content": "Example: Solve 8x + 9 < 6x − 7", "showAt": 48, "spItems": [] },
          { "name": "line", "type": "math", "content": "8x - 6x < -7 - 9", "showAt": 52, "spItems": [ { "type": "text", "content": "Move x-terms left, constants right" } ] },
          { "name": "line", "type": "math", "content": "2x < -16 \\quad \\Rightarrow \\quad x < -8", "showAt": 56, "spItems": [ { "type": "text", "content": "Divide by 2 (positive), so the symbol stays the same" } ] },
          { "name": "line", "type": "math", "content": "\\text{Solution set} = \\{x \\mid x \\in \\mathbb{R} \\land x < -8\\}", "showAt": 60, "spItems": [] }
        ]},
        { "type": "imageSlide", "start": 66, "end": 72, "data": [
          { "name": "image", "content": "ch5-inequality-dot-conventions.svg", "showAt": 66 }
        ]},
        { "type": "imageRightBulletsLeft", "start": 72, "end": 90, "data": [
          { "name": "image", "content": "ch5-inequality-dot-conventions.svg", "showAt": 72 },
          { "name": "bullet", "content": "An open dot means the number is NOT included (< or >)", "showAt": 74 },
          { "name": "bullet", "content": "A closed dot means the number IS included (≤ or ≥)", "showAt": 78 },
          { "name": "bullet", "content": "The shaded ray points toward the solutions: left for < and ≤, right for > and ≥", "showAt": 82 },
          { "name": "bullet", "content": "Always check the dot and the direction before reading a graph", "showAt": 86 }
        ]},
        { "type": "imageSlide", "start": 90, "end": 96, "data": [
          { "name": "image", "content": "ch5-compound-or-vs-and.svg", "showAt": 90 }
        ]},
        { "type": "imageLeftBulletsRight", "start": 96, "end": 116, "data": [
          { "name": "image", "content": "ch5-compound-or-vs-and.svg", "showAt": 96 },
          { "name": "bullet", "content": "Two inequalities joined by 'or' or 'and' form a compound inequality", "showAt": 98 },
          { "name": "bullet", "content": "'or' means union: x < 1 or x > 2 includes both rays", "showAt": 102 },
          { "name": "bullet", "content": "'and' means intersection: x ≥ 4 and x ≤ 7 keeps only the overlap, 4 ≤ x ≤ 7", "showAt": 106 },
          { "name": "bullet", "content": "An 'and' inequality can be written in combined form, e.g. −6 < 5x + 3 < 5", "showAt": 110 }
        ]},
        { "type": "eq", "start": 116, "end": 140, "data": [
          { "name": "line", "type": "heading", "content": "Example: Solve 5 < 2x + 3 < 17", "showAt": 116, "spItems": [] },
          { "name": "line", "type": "math", "content": "5 < 2x + 3 < 17", "showAt": 120, "spItems": [ { "type": "text", "content": "Work on all three parts together" } ] },
          { "name": "line", "type": "math", "content": "5 - 3 < 2x < 17 - 3", "showAt": 124, "spItems": [ { "type": "text", "content": "Subtract 3 from each part" } ] },
          { "name": "line", "type": "math", "content": "2 < 2x < 14", "showAt": 128, "spItems": [] },
          { "name": "line", "type": "math", "content": "1 < x < 7", "showAt": 132, "spItems": [ { "type": "text", "content": "Divide each part by 2" } ] },
          { "name": "line", "type": "text", "content": "So x lies between 1 and 7.", "showAt": 136, "spItems": [] }
        ]}
      ]
    }
  }
]