  {
    "slug": "fbise9math-ex2-2-q3-vi",
    "body": {
      "version": "deck-v2",
      "background": { "backgroundColor": "#05070c", "backgroundImage": "space.webp", "backgroundImageOpacity": 0.4 },
      "audio": "music.mp3",
      "deck": [
        { "type": "titleAndSubtitle", "data": [
          { "name": "title", "content": "Exercise 2.2 — Q3(vi)", "showAt": 0 },
          { "name": "subtitle", "content": "Find the Value of x", "showAt": 0 }
        ], "start": 0, "end": 5 },
        { "type": "eq", "data": [
          { "name": "line", "type": "math", "content": "\\log_2(x^2-1) = 3", "showAt": 5, "spItems": [
            { "type": "text", "content": "Convert to exponential form" }
          ]},
          { "name": "line", "type": "math", "content": "x^2-1 = 2^3 = 8 \\implies x^2 = 9", "showAt": 9, "spItems": [] },
          { "name": "line", "type": "math", "content": "x = \\pm 3", "showAt": 13, "spItems": [
            { "type": "text", "content": "Both satisfy x²-1 > 0, so both are valid" }
          ]}
        ], "start": 5, "end": 17 }
      ]
    }
  },
  {
