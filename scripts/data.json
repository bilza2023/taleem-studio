        ], "start": 0, "end": 5 },
        { "type": "eq", "data": [
          { "name": "line", "type": "math", "content": "\\log_x 3 = 1", "showAt": 5, "spItems": [
            { "type": "text", "content": "Convert to exponential form" }
          ]},
          { "name": "line", "type": "math", "content": "x^1 = 3 \\implies x = 3", "showAt": 9, "spItems": [] }
        ], "start": 5, "end": 13 }
