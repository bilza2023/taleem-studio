          { "name": "line", "type": "math", "content": "\\text{Which one is the solution of } \\frac{4}{x} - \\frac{2}{x} = 5\\text{?}", "showAt": 5, "spItems": [] },
          { "name": "line", "type": "math", "content": "\\text{(a) } -1 \\qquad \\text{(b) } \\frac{2}{5} \\qquad \\text{(c) } \\frac{5}{2} \\qquad \\text{(d) zero}", "showAt": 10, "spItems": [] },
          { "name": "line", "type": "math", "content": "\\frac{2}{x} = 5", "showAt": 15, "spItems": [ { "type": "text", "content": "Same denominator: subtract the numerators" } ] },
          { "name": "line", "type": "math", "content": "2 = 5x \\quad \\Rightarrow \\quad x = \\frac{2}{5}", "showAt": 20, "spItems": [ { "type": "text", "content": "Multiply both sides by x, then divide by 5" } ] },
          { "name": "line", "type": "text", "content": "Correct option: (b) 2/5", "showAt": 25, "spItems": [] }
