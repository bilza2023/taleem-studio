          ]},
          { "name": "line", "type": "math", "content": "2^{x+1} = 64 = 2^6", "showAt": 9, "spItems": [] },
          { "name": "line", "type": "math", "content": "x+1 = 6 \\implies x = 5", "showAt": 13, "spItems": [] }
        ], "start": 5, "end": 17 }
      ]
    }
  },
  {
    "slug": "fbise9math-ex2-2-q3-v",
