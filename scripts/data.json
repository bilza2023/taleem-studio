      "deck": [
        { "type": "eq", "start": 0, "end": 40, "data": [
          { "name": "line", "type": "heading", "content": "Miscellaneous Exercise 5 — Q1(xiv)", "showAt": 0, "spItems": [] },
          { "name": "line", "type": "text", "content": "Which one is the compound relation?", "showAt": 5, "spItems": [] },
          { "name": "line", "type": "math", "content": "\\text{(a) } 1 + 2x < 4 + x \\qquad \\text{(b) } 4x + 3 > 5\\frac{3}{5}", "showAt": 10, "spItems": [] },
          { "name": "line", "type": "math", "content": "\\text{(c) } x + y > 5\\frac{1}{2} \\qquad \\text{(d) } x \\le 0", "showAt": 15, "spItems": [] },
          { "name": "line", "type": "math", "content": "x \\le 0 \\quad \\text{means} \\quad x < 0 \\ \\text{or}\\ x = 0", "showAt": 20, "spItems": [ { "type": "text", "content": "Two relations joined by 'or' make a compound relation" } ] },
          { "name": "line", "type": "text", "content": "Options (a), (b) and (c) each use a single relation (< or >).", "showAt": 25, "spItems": [] },
          { "name": "line", "type": "text", "content": "Correct option: (d) x ≤ 0", "showAt": 30, "spItems": [] }
        ]}
      ]
    }
