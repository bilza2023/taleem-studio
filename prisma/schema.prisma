generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ContentType {
  ARTICLE
  PLAYER
  MCQ
}

enum LibraryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseAccess {
  OPEN
  MEMBERS
  SUBSCRIPTION
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum InquiryStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum NotificationAudience {
  APP      // everyone
  COURSE   // students of one course
  USER     // one student
}
///////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////
model Course {
  slug        String       @id
  title       String
  description String?
  sortOrder   Int          @default(0)
  thumbnail   String?
  access      CourseAccess @default(OPEN)
  isActive    Boolean      @default(true)
  price       Int          @default(0)

  groups        Group[]
  subscriptions Subscription[]
}

model Group {
  id          Int       @id @default(autoincrement())
  courseSlug  String
  slug        String
  title       String
  sortOrder   Int       @default(0)
  thumbnail   String?
  description String?
  course      Course    @relation(fields: [courseSlug], references: [slug], onDelete: Restrict)
  library     Library[]

  @@unique([courseSlug, slug])
  @@index([courseSlug])
}

model Library {
  slug               String        @id
  title              String
  description        String?
  narration          String?
  thumbnail          String?
  type               ContentType
  status             LibraryStatus @default(DRAFT)
  body               String?
  courseSlug         String
  groupSlug          String
  sortOrder          Int           @default(0)
  allowCommunication Boolean       @default(true)
  meta               String?
  tags               String        @default("[]")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  group Group @relation(fields: [courseSlug, groupSlug], references: [courseSlug, slug], onDelete: Restrict)

  ratings Rating[]
  
  @@index([courseSlug])
  @@index([groupSlug])
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  password       String
  name           String?
  createdAt      DateTime        @default(now())
  subscriptions  Subscription[]
  ratings   Rating[]
  inquiries Inquiry[]
}

model Admin {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  courseSlugs String    @default("[]")
  role        AdminRole @default(ADMIN)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Subscription {
  id          Int       @id @default(autoincrement())
  userId      Int
  courseSlug  String
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  amount      Int?
  cancelledAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseSlug], references: [slug], onDelete: Restrict)

  @@index([userId])
  @@index([courseSlug])
}


model Svg {
  slug String @id

  title String

  body String

  tags String @default("[]")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Image {
  slug String @id

  title String

  tags String @default("[]")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Audio {
  slug String @id

  title String

  tags String @default("[]")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id         Int      @id @default(autoincrement())
  name       String // "lesson.open", "lesson.complete", "user.login"
  userId     Int? // User.id or Admin.id, depending on role; null = anonymous
  role       String? // "student" | "admin" | null (anonymous)
  slug       String? // Library slug (or other target)
  courseSlug String? // copied in for per-course queries
  meta       String? // JSON text, same convention as Library.meta / Communication.meta
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, role, createdAt])
  @@index([slug])
  @@index([courseSlug, createdAt])
}


// one rating per student per deck — re-rating updates the row
model Rating {
  id          Int      @id @default(autoincrement())
  userId      Int
  librarySlug String
  courseSlug  String   // copied in for per-course queries
  stars       Int      // 1–5
  options     String   @default("[]") // JSON array of option keys
  comment     String?  // "What would you like us to improve?"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  library Library @relation(fields: [librarySlug], references: [slug], onDelete: Cascade)

  @@unique([userId, librarySlug])
  @@index([librarySlug])
  @@index([courseSlug, createdAt])
}

// student → app; each inquiry holds its own reply
model Inquiry {
  id          Int           @id @default(autoincrement())
  userId      Int
  courseSlug  String?       // optional context, not required
  message     String
  reply       String?
  repliedBy   String?       // admin email
  repliedAt   DateTime?
  replyReadAt DateTime?     // drives the "1 reply" badge
  status      InquiryStatus @default(OPEN)
  tags        String        @default("[]") // team triage only
  isPublic    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// app → students; stored once, filtered by audience
model Notification {
  id         Int                  @id @default(autoincrement())
  audience   NotificationAudience
  courseSlug String?              // when audience = COURSE
  userId     Int?                 // when audience = USER
  title      String
  body       String?
  link       String?              // optional "open this" target
  createdBy  String?              // admin email
  publishAt  DateTime             @default(now())
  expiresAt  DateTime?
  createdAt  DateTime             @default(now())

  @@index([audience, publishAt])
  @@index([courseSlug, publishAt])
  @@index([userId, publishAt])
}