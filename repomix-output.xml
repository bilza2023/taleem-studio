import { getDeckEndTime } from "./getDeckEndTime.js";
import { getAudioFileName } from "./getAudioFileName.js";
import { resolveAssetPaths } from "./resolveAssetPaths.js";

export function prepareDeck(
	deck,
	ASSET_BASE
) {

	if (!deck) return null;

	resolveAssetPaths(
		deck,
		ASSET_BASE
	);

	return {

		deck,

		deckEndTime:
			getDeckEndTime(deck),

		audioFileName:
			getAudioFileName(deck)

	};

}
