<script>
///home/bilal-tariq/00--TALEEM/taleem.studio/src/lib/components/Communication.svelte

	import { send } from "$lib/send";

	let { librarySlug, type } = $props();

	let message = $state("");
	let sending = $state(false);
	let status = $state("");

	async function sendMessage() {

		if (!message.trim()) return;

		sending = true;
		status = "";

		try {

			await send("communication", "create", { librarySlug, type, message }, "user");

			message = "";
			status = "✓ Thank you. Your message has been sent.";

		}
		catch (err) {

			status = err.message;

		}
		finally {

			sending = false;

		}

	}
</script>

<section class="communication">
	<h3>Questions / Feedback</h3>

	<textarea
		bind:value={message}
		rows="5"
		placeholder="Ask a question, report a mistake, or send feedback..."
	></textarea>

	<p>
		<button
			onclick={sendMessage}
			disabled={sending || !message.trim()}
		>
			{sending ? "Sending..." : "Send"}
		</button>
	</p>

	{#if status}
		<p>{status}</p>
	{/if}
</section>

