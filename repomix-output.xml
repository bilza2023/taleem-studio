<file path="src/lib/player/css/barChart.css">
.slide.barChart {
  align-items: center;
  justify-content: center;
  text-align: left;
}

/* wrapper */
.slide.barChart .bar-chart {
  width: 100%;
  max-width: 900px;

  display: flex;
  flex-direction: column;
  gap: 2.4rem;
}

/* row */
.slide.barChart .bar-row {
  display: flex;
  align-items: center;
  gap: 2rem;

  opacity: 0;
  transform: translateY(10px);

  animation: rowSoftIn 0.4s ease-out forwards;
}

/* stagger rows */
.slide.barChart .bar-row:nth-child(1) { animation-delay: 0.15s; }
.slide.barChart .bar-row:nth-child(2) { animation-delay: 0.3s; }
.slide.barChart .bar-row:nth-child(3) { animation-delay: 0.45s; }
.slide.barChart .bar-row:nth-child(4) { animation-delay: 0.6s; }

/* label */
.slide.barChart .bar-label {
  width: 220px;
  flex-shrink: 0;

  font-size: 2.4rem;
  opacity: 0.9;
}

/* track */
.slide.barChart .bar-track {
  flex: 1;
  height: 28px;

  background: rgba(0, 0, 0, 0.08);
  border-radius: 14px;

  overflow: hidden;
}

/* fill (already animated) */
.slide.barChart .bar-fill {
  height: 100%;
  width: 0;

  background: #f5c542;
  border-radius: 14px;

  transition: width 0.6s ease;
}

/* value */
.slide.barChart .bar-value {
  width: 60px;
  text-align: right;

  font-size: 2.2rem;
  opacity: 0.85;
}

/* animation */
@keyframes rowSoftIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
/* mobile */
@media (max-width: 768px) {

  .slide.barChart .bar-chart {
    gap: 1.4rem;
  }

  .slide.barChart .bar-row {
    gap: 1rem;
  }

  .slide.barChart .bar-label {
    width: 90px;
    font-size: 1rem;
  }

  .slide.barChart .bar-value {
    width: 36px;
    font-size: 0.95rem;
  }

  .slide.barChart .bar-track {
    height: 16px;
  }

}
</file>

