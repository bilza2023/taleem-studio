export function getDeckEndTime(deck) {
    if (!deck || !deck.deck || deck.deck.length === 0) {
      return 0;
    }
  
    return deck.deck[deck.deck.length - 1].end;
  }
</file>

<file path="src/lib/player/utils/getSlideAtTime.js">
export function getSlideAtTime(deck, time) {
    if (!deck || !Array.isArray(deck.deck)) return null;
  
    const slides = deck.deck;
  
    for (let i = slides.length - 1; i >= 0; i--) {
      const s = slides[i];
      if (time >= s.start && time < s.end) {
        return s;
      }
    }
  
    return null;
  }
</file>

