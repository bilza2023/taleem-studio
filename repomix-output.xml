<file path="src/lib/player/css/eq.css">
/* ======================================
   EQ Slide
====================================== */

annotation {
	display: none !important;
  }
  
  .slide.eq {
	display: flex;
	flex-direction: row;
  
	align-items: flex-start;
	justify-content: space-between;
  
	gap: 1.2rem;
  
	padding-left: 2.5rem;
	padding-right: 2.5rem;
  
	overflow: hidden;
  
	color: gray;
  }
  
  
  /* -------------------------------
	 Left: Equation Lines
  ---------------------------------- */
  
  .slide.eq .eq-lines {
	flex: 0 0 48%;
  
	min-width: 0;
  
	overflow: hidden;
  
	list-style: none;
  
	padding: 0;
	margin: 0;
  
	display: flex;
	flex-direction: column;
  }
  
  
  /* BASE LINE */
  
  .slide.eq .eq-lines li {
	padding: 0.45rem 0.7rem;
  
	font-size: 1.1rem;
	line-height: 1.15;
  
	border-bottom: 1px solid rgba(255,255,255,0.08);
  
	background: transparent;
  
	color: rgba(255,255,255,0.88);
  
	overflow-x: auto;
	overflow-y: hidden;
  
	max-width: 100%;
  
	transition:
	  background 0.25s ease,
	  border 0.25s ease,
	  transform 0.25s ease,
	  opacity 0.25s ease;
  }
  
  
  /* DIMMED */
  
  .slide.eq .eq-lines li.dim {
	opacity: 0.32;
  }
  
  
  /* ACTIVE / HIGHLIGHTED */
  
  .slide.eq .eq-lines li.highlighted {
	background: rgba(255,215,0,0.16);
  
	color: #ffffff;
  
	border: 2px solid #ffd54a;
  
	border-radius: 10px;
  
	font-weight: 700;
  
	box-shadow:
	  0 0 0 1px rgba(255,255,255,0.05),
	  0 6px 18px rgba(0,0,0,0.4);
  
	transform: scale(1.01);
  
	position: relative;
  
	z-index: 2;
  
	opacity: 1;
  }
  
  
  /* TITLE */
  
  .slide.eq .eq-title {
	font-size: 1.45rem;
	font-weight: 700;
  
	color: #ffffff;
  }
  
  
  /* MATH */
  
  .slide.eq .eq-math {
	font-size: 1.2rem;
  }
  
  
  /* TEXT */
  
  .slide.eq .eq-line {
	font-size: 1rem;
  }
  
  
  /* KaTeX tuning */
  
  .slide.eq .katex {
	font-size: 1em;
  }
  
  .slide.eq .katex-display {
	margin: 0;
  }
  
  
  /* -------------------------------
	 Right: Side Panel
  ---------------------------------- */
  
  .slide.eq .eq-side-panel {
	flex: 0 0 52%;
  
	min-width: 0;
  
	overflow: hidden;
  
	padding: 0.45rem;
  
	background: rgba(0,0,0,0.35);
  
	border: 1px solid rgba(255,255,255,0.16);
  
	border-radius: 14px;
  
	display: flex;
	flex-direction: column;
  
	gap: 0.35rem;
  }
  
  
  /* Explanation text */
  
  .slide.eq .eq-explain-item {
	font-size: 0.95rem;
	line-height: 1.25;
  
	text-align: justify;
  
	background: rgba(255,255,255,0.05);
  
	padding: 0.7rem 0.9rem;
  
	border-radius: 10px;
  
	overflow-wrap: break-word;
  }
  
  
  /* Explanation image */
  
  .slide.eq .eq-explain-item img {
	width: 70%;
  
	margin: 0 auto;
  
	display: block;
  
	border-radius: 10px;
  }
  
  
  /* ======================================
	 Desktop Layout (≥1024px)
  ====================================== */
  
  @media (min-width: 1024px) {
  
	.slide.eq {
	  gap: 1.5rem;
	}
  
	.slide.eq .eq-lines li {
	  font-size: 1.25rem;
  
	  line-height: 1.18;
	}
  
	.slide.eq .eq-title {
	  font-size: 1.7rem;
	}
  
	.slide.eq .eq-math {
	  font-size: 1.35rem;
	}
  
	.slide.eq .eq-explain-item {
	  font-size: 1rem;
  
	  line-height: 1.3;
	}
  
  }
  
  
  /* ======================================
	 Large Desktop / Projector
  ====================================== */
  
  @media (min-width: 1600px) {
  
	.slide.eq {
	  gap: 1.8rem;
  
	  padding-left: 4rem;
	  padding-right: 4rem;
	}
  
