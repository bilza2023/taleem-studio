		backgroundImage: z.string().nullable().optional(),
		backgroundImageOpacity: z.number().optional()
	}).optional(),

	deck: z.array(
		z.discriminatedUnion("type", [
			titleAndSubtitle,
			titleAndPara,
			bulletList,
			twoColumnText,
			imageSlide,
			fillImage,
			imageWithTitle,
			imageWithCaption,
			imageLeftBulletsRight,
			imageRightBulletsLeft,
			table,
			barChart,
			progressbar,
			quoteSlide,
			keyIdeasSlide,
			eq
		])
	)

});

export const eqLineArraySchema = eq.shape.data;
